<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows: a picture of the real 2 x 1 widget. A picture only scales, so
     launchers with their own font size no longer wrap or cut the text, as they did with a layout. -->
<ImageView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitCenter"
    android:src="@drawable/widget_preview_img" />
