<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, and only certificates the system trusts (not ones a user or an app installed). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
